<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>List Item or Request - Campus Marketplace</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>
<header>
    <h1>List Campus Item or Request</h1>
    <nav style="margin-top: 1rem;">
        <a href="{{ url_for('home') }}" style="color: #fff; margin: 0 0.75rem; text-decoration: none; font-weight: bold;">Browse Items</a>
        <a href="{{ url_for('view_requests') }}" style="color: #ffeaa7; margin: 0 0.75rem; text-decoration: none; font-weight: bold;">Request Board</a>
        <a href="{{ url_for('logout') }}" style="color: #ff7675; margin: 0 0.75rem; text-decoration: none; font-weight: bold;">Logout</a>
    </nav>
</header>

<div class="container">
    {% with messages = get_flashed_messages() %}
    {% if messages %}
    <div class="form-section" style="padding: 0.8rem; border-left: 4px solid #e74c3c; background-color: #fdecea;">
        {% for message in messages %}<p style="color: #c0392b; font-weight: 500;">{{ message }}</p>{% endfor %}
    </div>
    {% endif %}
    {% endwith %}

    <!-- Option 1: List Item / Resource -->
    <div class="form-section">
        <h2>1. List an Item / Study Resource</h2>
        <p style="font-size: 0.9rem; color: #666; margin-bottom: 1rem;">List laptops, calculators, books, notes, or hostel items for other students.</p>
        <form action="{{ url_for('add_resource') }}" method="POST" enctype="multipart/form-data">
            <input type="text" name="title" placeholder="Item Name (e.g., Dell Laptop i5 / DBMS Notes)" minlength="3" required>
            <select name="category" required>
                <option value="" disabled selected>Select Category</option>
                <option value="Electronics & Laptops">Electronics & Laptops</option>
                <option value="Books & Notes">Books & Notes</option>
                <option value="PYQs & Assignments">PYQs & Assignments</option>
                <option value="Hostel & Accessories">Hostel & Accessories</option>
                <option value="Other">Other</option>
            </select>
            <input type="text" name="price" placeholder="Price (e.g., Free or ₹15,000)" required>
            <select name="is_available" required>
                <option value="true" selected>Status: Available</option>
                <option value="false">Status: Not Available</option>
            </select>
            <input type="text" name="description" placeholder="Condition / Details (e.g., Good condition, 8GB RAM)" required>
            <input type="tel" name="contact" value="{{ current_user.phone }}" placeholder="10-Digit Mobile Number" pattern="[6-9][0-9]{9}" maxlength="10" title="Exact 10-digit mobile number" required>
            <input type="file" name="file" accept=".jpg,.jpeg,.png,.pdf,.docx,.pptx" style="grid-column: span 2;" required>
            <button type="submit">List Item Now</button>
        </form>
    </div>

    <!-- Option 2: Request -->
    <div class="form-section">
        <h2>2. Request an Item / Resource</h2>
        <form action="{{ url_for('request_resource') }}" method="POST">
            <input type="text" name="topic" placeholder="Item Needed (e.g., Scientific Calculator / Laptop Charger)" minlength="3" required>
            <select name="category" required>
                <option value="" disabled selected>Select Category</option>
                <option value="Electronics & Laptops">Electronics & Laptops</option>
                <option value="Books & Notes">Books & Notes</option>
                <option value="PYQs & Assignments">PYQs & Assignments</option>
                <option value="Hostel & Accessories">Hostel & Accessories</option>
                <option value="Other">Other</option>
            </select>
            <input type="text" name="details" placeholder="Details / Urgency / Semester" style="grid-column: span 2;" required>
            <button type="submit" style="background-color: #e67e22;">Post Request</button>
        </form>
    </div>
</div>
</body>
</html>
